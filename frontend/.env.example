# API 地址（推荐 /api，由 vite 代理到 localhost:8000）
VITE_API_BASE_URL=/api

# 全局 Mock 开关（true = 默认 Mock，可按模块覆盖）
VITE_USE_MOCK=true

# 已完成后端联调的模块设为 false
VITE_MOCK_AUTH=false
VITE_MOCK_SESSIONS=false
VITE_MOCK_TASKS=false
VITE_MOCK_FORMS=false
VITE_MOCK_SETTINGS=false
VITE_MOCK_KNOWLEDGE=false
VITE_MOCK_ADMIN=false
